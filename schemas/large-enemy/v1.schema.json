{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mam-engine.local/schemas/large-enemy/v1.schema.json",
  "title": "Large Enemy Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "displayName", "healthFile", "reactionFile", "telegraphName", "idleDurationSeconds", "telegraphDurationSeconds", "attackDurationSeconds", "recoveryDurationSeconds", "bodyParts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "large-enemy-profile" },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "healthFile": { "type": "string", "minLength": 1 },
    "reactionFile": { "type": "string", "minLength": 1 },
    "telegraphName": { "type": "string", "minLength": 1 },
    "idleDurationSeconds": { "type": "number", "minimum": 0 },
    "telegraphDurationSeconds": { "type": "number", "minimum": 0 },
    "attackDurationSeconds": { "type": "number", "minimum": 0 },
    "recoveryDurationSeconds": { "type": "number", "minimum": 0 },
    "bodyParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "hurtboxFile", "targetPoint", "targetable"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "hurtboxFile": { "type": "string", "minLength": 1 },
          "targetPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          },
          "targetable": { "type": "boolean" }
        }
      }
    }
  }
}
