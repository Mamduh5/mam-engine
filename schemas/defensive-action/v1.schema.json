{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mam-engine.local/schemas/defensive-action/v1.schema.json",
  "title": "mam-engine defensive action profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "displayName", "durationSeconds", "staminaCost", "movementDistance", "invulnerabilityStartSeconds", "invulnerabilityEndSeconds", "cooldownSeconds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "defensive-action-profile" },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "durationSeconds": { "type": "number" },
    "staminaCost": { "type": "number" },
    "movementDistance": { "type": "number" },
    "invulnerabilityStartSeconds": { "type": "number" },
    "invulnerabilityEndSeconds": { "type": "number" },
    "cooldownSeconds": { "type": "number" }
  }
}
