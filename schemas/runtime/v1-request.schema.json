{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mam-engine.local/schemas/runtime/v1-request.schema.json",
  "title": "mam runtime v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "fixtureId", "correlationId", "requestedAt", "timeoutMs", "payload"],
  "properties": {
    "schemaVersion": { "const": "mam.runtime/v1" },
    "commandId": { "const": "runtime.fixture.run" },
    "fixtureId": { "enum": ["movement/basic-ground", "movement/interactive-sandbox", "camera/basic-third-person", "targeting/basic-lock-on", "defensive-action/basic-dodge", "offensive-action/basic-light-attack", "health/basic-confirmed-hit", "large-enemy/training-behemoth", "encounter/training-hunt"] },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "requestedAt": { "type": "string" },
    "timeoutMs": { "type": "number", "exclusiveMinimum": 0, "maximum": 60000 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "fixtureId": { "const": "movement/basic-ground" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/movementPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "movement/interactive-sandbox" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/movementSandboxPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "camera/basic-third-person" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/cameraPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "targeting/basic-lock-on" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/targetingPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "defensive-action/basic-dodge" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/defensiveActionPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "offensive-action/basic-light-attack" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/offensiveActionPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "health/basic-confirmed-hit" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/healthPayload" } } }
    },
    {
      "if": { "properties": { "fixtureId": { "const": "large-enemy/training-behemoth" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/largeEnemyPayload" } } }
    }
  ],
  "$defs": {
    "movementPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionSchemaVersion", "profile", "scenario"],
      "properties": {
        "definitionKind": { "const": "movement-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../movement/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds", "cameraYawDegrees"],
          "properties": {
            "id": { "enum": ["accelerate", "stop", "sprint", "dodge", "turn"] },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "const": 0.016666666666666666 },
            "cameraYawDegrees": { "type": "number" }
          }
        }
      }
    },
    "movementSandboxPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "scenario"],
      "properties": {
        "definitionKind": { "const": "movement-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../movement/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds", "automatedInput"],
          "properties": {
            "id": { "enum": ["interactive", "automated"] },
            "durationSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "const": 0.016666666666666666 },
            "automatedInput": { "type": "boolean" }
          }
        }
      }
    },
    "cameraPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "scenario"],
      "properties": {
        "definitionKind": { "const": "camera-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../camera/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds"],
          "properties": {
            "id": { "enum": ["orbit", "pitch-clamp", "recenter", "follow", "collision", "basis"] },
            "durationSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "variant": { "enum": ["default", "disabled", "below-threshold", "manual-input"] }
          }
        }
      }
    },
    "defensiveActionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "scenario"],
      "properties": {
        "definitionKind": { "const": "defensive-action-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../defensive-action/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds"],
          "properties": {
            "id": { "const": "default" },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "offensiveActionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "scenario"],
      "properties": {
        "definitionKind": { "const": "offensive-action-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../offensive-action/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds"],
          "properties": {
            "id": { "const": "default" },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "healthPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "offensiveActionDefinitionKind", "offensiveActionDefinitionSchemaVersion", "offensiveActionProfile", "scenario"],
      "properties": {
        "definitionKind": { "const": "health-profile" },
        "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../health/v1.schema.json" },
        "offensiveActionDefinitionKind": { "const": "offensive-action-profile" },
        "offensiveActionDefinitionSchemaVersion": { "const": 1 },
        "offensiveActionProfile": { "$ref": "../offensive-action/v1.schema.json" },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "durationSeconds", "fixedDeltaSeconds"],
          "properties": {
            "id": { "const": "confirmed-hit" },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "vector3": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }
    },
    "targetingCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "targetPoint", "targetable", "priority", "obstruction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "targetPoint": { "$ref": "#/$defs/vector3" },
        "targetable": { "type": "boolean" }, "priority": { "type": "number", "minimum": 0, "maximum": 1 },
        "obstruction": { "enum": ["none", "controlled-wall"] }
      }
    },
    "targetingEvent": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["step", "type"], "properties": { "step": { "type": "integer", "minimum": 1 }, "type": { "const": "request-acquire" } } },
        { "type": "object", "additionalProperties": false, "required": ["step", "type", "targetId", "obstruction"], "properties": { "step": { "type": "integer", "minimum": 1 }, "type": { "const": "set-obstruction" }, "targetId": { "type": "string", "minLength": 1 }, "obstruction": { "enum": ["none", "controlled-wall"] } } },
        { "type": "object", "additionalProperties": false, "required": ["step", "type", "targetId", "targetable"], "properties": { "step": { "type": "integer", "minimum": 1 }, "type": { "const": "set-targetable" }, "targetId": { "type": "string", "minLength": 1 }, "targetable": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["step", "type", "targetId", "targetPoint"], "properties": { "step": { "type": "integer", "minimum": 1 }, "type": { "const": "move-target" }, "targetId": { "type": "string", "minLength": 1 }, "targetPoint": { "$ref": "#/$defs/vector3" } } },
        { "type": "object", "additionalProperties": false, "required": ["step", "type", "direction"], "properties": { "step": { "type": "integer", "minimum": 1 }, "type": { "const": "request-switch" }, "direction": { "enum": ["left", "right"] } } }
      ]
    },
    "targetingScenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "durationSeconds", "fixedDeltaSeconds", "origin", "viewForward", "initialTargetId", "initialSwitchCooldownSeconds", "candidates", "events"],
      "properties": {
        "id": { "enum": ["acquire", "eligibility", "tie-break", "retention", "loss", "reacquire", "switch-left", "switch-right", "switch-cooldown", "framing-acquire", "framing-switch", "framing-loss", "framing-reacquire"] },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "origin": { "$ref": "#/$defs/vector3" }, "viewForward": { "$ref": "#/$defs/vector3" },
        "initialTargetId": { "type": ["string", "null"] }, "initialSwitchCooldownSeconds": { "type": "number", "minimum": 0 },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/targetingCandidate" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/targetingEvent" } }
      }
    },
    "targetingPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["definitionKind", "definitionSchemaVersion", "profile", "cameraDefinitionKind", "cameraDefinitionSchemaVersion", "cameraProfile", "scenario"],
      "properties": {
        "definitionKind": { "const": "targeting-profile" }, "definitionSchemaVersion": { "const": 1 },
        "profile": { "$ref": "../targeting/v1.schema.json" },
        "cameraDefinitionKind": { "const": "camera-profile" }, "cameraDefinitionSchemaVersion": { "const": 1 },
        "cameraProfile": { "$ref": "../camera/v1.schema.json" }, "scenario": { "$ref": "#/$defs/targetingScenario" }
      }
    },
    "largeEnemyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largeEnemyDefinitionKind", "largeEnemyDefinitionSchemaVersion", "largeEnemyProfile", "resolvedDefinitionPaths", "healthDefinitionKind", "healthDefinitionSchemaVersion", "healthProfile", "reactionDefinitionKind", "reactionDefinitionSchemaVersion", "reactionProfile", "hurtboxDefinitionKind", "hurtboxDefinitionSchemaVersion", "hurtboxProfiles", "scenario"],
      "properties": {
        "largeEnemyDefinitionKind": { "const": "large-enemy-profile" },
        "largeEnemyDefinitionSchemaVersion": { "const": 1 },
        "largeEnemyProfile": { "$ref": "../large-enemy/v1.schema.json" },
        "resolvedDefinitionPaths": {
          "type": "object", "additionalProperties": false, "required": ["healthFile", "reactionFile", "bodyParts"],
          "properties": {
            "healthFile": { "type": "string", "minLength": 1 }, "reactionFile": { "type": "string", "minLength": 1 },
            "bodyParts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "hurtboxFile"], "properties": { "id": { "type": "string", "minLength": 1 }, "hurtboxFile": { "type": "string", "minLength": 1 } } } }
          }
        },
        "healthDefinitionKind": { "const": "health-profile" }, "healthDefinitionSchemaVersion": { "const": 1 }, "healthProfile": { "$ref": "../health/v1.schema.json" },
        "reactionDefinitionKind": { "const": "damage-reaction-profile" }, "reactionDefinitionSchemaVersion": { "const": 1 }, "reactionProfile": { "$ref": "../damage-reaction/v1.schema.json" },
        "hurtboxDefinitionKind": { "const": "contact-volume-profile" }, "hurtboxDefinitionSchemaVersion": { "const": 1 }, "hurtboxProfiles": { "type": "array", "items": { "$ref": "../contact-volume/v1.schema.json" } },
        "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "durationSeconds", "fixedDeltaSeconds"], "properties": { "id": { "enum": ["full-cycle", "primary-part-disabled"] }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }, "fixedDeltaSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } }
      }
    }
  }
}
